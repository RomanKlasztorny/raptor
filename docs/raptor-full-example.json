      "customLabel": "orders.created",
      "x": 1100,
      "y": 520,
      "w": 200,
      "h": 64,
      "patterns": [],
      "settings": {
        "topic_name": "orders.created",
        "partitions": 6,
        "replication": 3,
        "brokers": 3,
        "min_insync": 2,
        "acks": "all",
        "delivery": "at-least-once",
        "key_strategy": "by-entity",
        "assignor": "cooperative-sticky",
        "poll_rate": 6,
        "cleanup": "delete",
        "retention_msgs": 300,
        "retry_dlq": true,
        "max_retries": 3
      }
    },
